import tkinter as tk
from tkinter import ttk, messagebox
import sqlite3

# Database class
class Database:
    def __init__(self, db_file):
        self.conn = sqlite3.connect(db_file)
        self.cursor = self.conn.cursor()
        self.initialize_database()

    def initialize_database(self):
        # Create tables if they do not exist
        self.cursor.execute('''
        CREATE TABLE IF NOT EXISTS Customer (
            CustomerID INTEGER PRIMARY KEY AUTOINCREMENT,
            Name TEXT NOT NULL,
            Email TEXT NOT NULL UNIQUE,
            Password TEXT NOT NULL,
            Address TEXT NOT NULL,
            PhoneNumber TEXT NOT NULL
        )''')

        self.cursor.execute('''
        CREATE TABLE IF NOT EXISTS Product (
            ProductID INTEGER PRIMARY KEY AUTOINCREMENT,
            Name TEXT NOT NULL,
            Description TEXT NOT NULL,
            Price REAL NOT NULL,
            Quantity INTEGER NOT NULL
        )''')

        self.cursor.execute('''
        CREATE TABLE IF NOT EXISTS Order_ (
            OrderID INTEGER PRIMARY KEY AUTOINCREMENT,
            OrderDate TEXT NOT NULL,
            CustomerID INTEGER NOT NULL,
            TotalAmount REAL NOT NULL,
            FOREIGN KEY (CustomerID) REFERENCES Customer(CustomerID)
        )''')

        self.cursor.execute('''
        CREATE TABLE IF NOT EXISTS Item (
            ItemID INTEGER PRIMARY KEY AUTOINCREMENT,
            OrderID INTEGER NOT NULL,
            ProductID INTEGER NOT NULL,
            Quantity INTEGER NOT NULL,
            Price REAL NOT NULL,
            FOREIGN KEY (OrderID) REFERENCES Order_(OrderID),
            FOREIGN KEY (ProductID) REFERENCES Product(ProductID)
        )''')

        self.cursor.execute('''
        CREATE TABLE IF NOT EXISTS Payment (
            PaymentID INTEGER PRIMARY KEY AUTOINCREMENT,
            OrderID INTEGER NOT NULL,
            PaymentDate TEXT NOT NULL,
            PaymentAmount REAL NOT NULL,
            PaymentMethod TEXT NOT NULL,
            FOREIGN KEY (OrderID) REFERENCES Order_(OrderID)
        )''')

        self.cursor.execute('''
        CREATE TABLE IF NOT EXISTS Shipping (
            ShippID INTEGER PRIMARY KEY AUTOINCREMENT,
            OrderID INTEGER NOT NULL,
            ShippDate TEXT NOT NULL,
            ShippAddress TEXT NOT NULL,
            ShippStatus TEXT NOT NULL,
            FOREIGN KEY (OrderID) REFERENCES Order_(OrderID)
        )''')
        self.conn.commit()

    def execute(self, query, params=()):
        self.cursor.execute(query, params)
        self.conn.commit()

    def fetch(self, query, params=()):
        self.cursor.execute(query, params)
        return self.cursor.fetchall()

    def close(self):
        self.conn.close()

# GUI class
class ECommerceGUI:
    def __init__(self, root):
        self.db = Database("ecommerce.db")
        self.root = root
        self.root.title("E-Commerce Management")

        # Apply custom background color
        self.root.configure(bg="lightblue")

        # Notebook for tabs
        self.notebook = ttk.Notebook(root)
        self.notebook.pack(expand=True, fill="both")

        # Add tabs for each entity
        self.create_customer_tab()
        self.create_product_tab()
        self.create_order_tab()
        self.create_item_tab()
        self.create_payment_tab()
        self.create_shipping_tab()

    def create_customer_tab(self):
        self.create_entity_tab(
            "Customers",
            ["Name", "Email", "Password", "Address", "Phone Number"],
            "Customer",
            "CustomerID"
        )

    def create_product_tab(self):
        self.create_entity_tab(
            "Products",
            ["Name", "Description", "Price", "Quantity"],
            "Product",
            "ProductID"
        )

    def create_order_tab(self):
        self.create_entity_tab(
            "Orders",
            ["OrderDate", "CustomerID", "TotalAmount"],
            "Order_",
            "OrderID"
        )

    def create_item_tab(self):
        self.create_entity_tab(
            "Items",
            ["OrderID", "ProductID", "Quantity", "Price"],
            "Item",
            "ItemID"
        )

    def create_payment_tab(self):
        self.create_entity_tab(
            "Payments",
            ["OrderID", "PaymentDate", "PaymentAmount", "PaymentMethod"],
            "Payment",
            "PaymentID"
        )

    def create_shipping_tab(self):
        self.create_entity_tab(
            "Shipping",
            ["OrderID", "ShippDate", "ShippAddress", "ShippStatus"],
            "Shipping",
            "ShippID"
        )

    def create_entity_tab(self, tab_name, fields, table_name, primary_key):
        tab = ttk.Frame(self.notebook)
        self.notebook.add(tab, text=tab_name)

        # Labels and entries
        entries = {}
        for i, field in enumerate(fields):
            tk.Label(tab, text=field, bg="lightblue").grid(row=i, column=0)
            entry = tk.Entry(tab, bg="white")
            entry.grid(row=i, column=1)
            entries[field] = entry

        # Treeview for displaying records
        tree = ttk.Treeview(tab, columns=("ID", *fields), show="headings")
        for col in ("ID", *fields):
            tree.heading(col, text=col)
        tree.grid(row=len(fields) + 2, column=0, columnspan=2)

        # Buttons
        tk.Button(tab, text=f"Add {tab_name[:-1]}", command=lambda: self.add_record(entries, table_name, fields, tree), bg="green", fg="white").grid(row=len(fields), column=0)
        tk.Button(tab, text=f"Update {tab_name[:-1]}", command=lambda: self.update_record(entries, table_name, fields, primary_key, tree), bg="orange", fg="white").grid(row=len(fields), column=1)
        tk.Button(tab, text=f"Delete {tab_name[:-1]}", command=lambda: self.delete_record(table_name, primary_key, tree), bg="red", fg="white").grid(row=len(fields) + 1, column=0)
        tk.Button(tab, text=f"View {tab_name}", command=lambda: self.view_records(tree, table_name), bg="blue", fg="white").grid(row=len(fields) + 1, column=1)

        self.view_records(tree, table_name)

    def add_record(self, entries, table_name, fields, tree):
        values = [entries[field].get() for field in fields]
        if not all(values):
            messagebox.showerror("Error", "All fields are required!")
            return
        try:
            self.db.execute(
                f"INSERT INTO {table_name} ({', '.join(fields)}) VALUES ({', '.join(['?' for _ in fields])})",
                values,
            )
            messagebox.showinfo("Success", f"{table_name[:-1]} added successfully!")
            self.view_records(tree, table_name)
        except sqlite3.IntegrityError as e:
            messagebox.showerror("Error", f"Database error: {e}")

    def update_record(self, entries, table_name, fields, primary_key, tree):
        selected_item = tree.selection()
        if not selected_item:
            messagebox.showerror("Error", "No record selected!")
            return

        record_id = tree.item(selected_item[0], "values")[0]
        values = [entries[field].get() for field in fields]
        if not all(values):
            messagebox.showerror("Error", "All fields are required!")
            return
        try:
            self.db.execute(
                f"UPDATE {table_name} SET {', '.join([f'{field} = ?' for field in fields])} WHERE {primary_key} = ?",
                values + [record_id],
            )
            messagebox.showinfo("Success", f"{table_name[:-1]} updated successfully!")
            self.view_records(tree, table_name)
        except sqlite3.IntegrityError as e:
            messagebox.showerror("Error", f"Database error: {e}")

    def delete_record(self, table_name, primary_key, tree):
        selected_item = tree.selection()
        if not selected_item:
            messagebox.showerror("Error", "No record selected!")
            return

        record_id = tree.item(selected_item[0], "values")[0]
        try:
            self.db.execute(f"DELETE FROM {table_name} WHERE {primary_key} = ?", (record_id,))
            messagebox.showinfo("Success", f"{table_name[:-1]} deleted successfully!")
            self.view_records(tree, table_name)
        except sqlite3.IntegrityError as e:
            messagebox.showerror("Error", f"Database error: {e}")

    def view_records(self, tree, table_name):
        for row in tree.get_children():
            tree.delete(row)
        rows = self.db.fetch(f"SELECT * FROM {table_name}")
        for row in rows:
            tree.insert("", "end", values=row)

if __name__ == "__main__":
    root = tk.Tk()
    app = ECommerceGUI(root)
    root.mainloop()
